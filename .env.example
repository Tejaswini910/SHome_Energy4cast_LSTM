# =========================================================
# Smart Home Energy Forecasting - Environment Configuration
# Copy this file to ".env" and adjust values as needed.
# =========================================================

# Path to the raw/clean household power consumption dataset
DATA_PATH=data/household_power.csv

# Model artifact paths
MODEL_PATH=models/lstm_model.keras
SCALER_PATH=models/scaler.joblib

# Sequence/window configuration
# 96 records = past 24 hours at 15-minute intervals
SEQUENCE_LENGTH=96
RESAMPLE_FREQ=15min

# Forecast horizons (in number of 15-minute steps: 1=15min, 2=30min, 3=45min, 4=60min)
FORECAST_HORIZONS=1,2,3,4

# Energy cost configuration
ENERGY_COST_PER_KWH=0.15
CURRENCY_SYMBOL=$

# Alerting thresholds
HIGH_CONSUMPTION_THRESHOLD_PCT=25
